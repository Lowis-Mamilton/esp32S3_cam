# Writes ${OUT} with the firmware's git identity; run at every build by the
# mxcam_git_header target (main/CMakeLists.txt). The file is rewritten only
# when its content changes, so an unchanged hash does not recompile main.
#   MXCAM_FW_GIT       7 chars for GET_INFO: short hash, or 6 chars + '+'
#                      when the work tree is dirty; "unknown" without git
#   MXCAM_FW_GIT_DESC  for the boot log: "<hash>" or "<hash>-dirty"
# --no-optional-locks: never take index.lock (an IDE may run git at the same
# time); safe.directory: CI containers check out as another user.
get_filename_component(REPO "${REPO}" ABSOLUTE)
set(GIT git --no-optional-locks -c "safe.directory=${REPO}" -C "${REPO}")
execute_process(
    COMMAND ${GIT} rev-parse --short=7 HEAD
    OUTPUT_VARIABLE hash
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR hash STREQUAL "")
    set(git7 "unknown")
    set(desc "unknown")
else()
    string(SUBSTRING "${hash}" 0 7 hash)
    # Tracked changes only (untracked files, e.g. editor leftovers, do not count).
    execute_process(
        COMMAND ${GIT} status --porcelain --untracked-files=no
        OUTPUT_VARIABLE changes
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE rc2)
    if(rc2 EQUAL 0 AND NOT changes STREQUAL "")
        string(SUBSTRING "${hash}" 0 6 h6)
        set(git7 "${h6}+")
        set(desc "${hash}-dirty")
    else()
        set(git7 "${hash}")
        set(desc "${hash}")
    endif()
endif()
set(content "/* Generated by gen_git_header.cmake at build time. Do not edit. */
#pragma once
#define MXCAM_FW_GIT \"${git7}\"
#define MXCAM_FW_GIT_DESC \"${desc}\"
")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
