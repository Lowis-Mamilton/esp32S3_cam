CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# AprilTag (mxcam_tag, vendored apriltag) mallocs freely; plain malloc may use
# PSRAM and only requests <= 4 KB are tried in internal RAM first, so its large
# working buffers land in PSRAM. DMA buffers use heap_caps_malloc explicitly.
CONFIG_SPIRAM_USE_MALLOC=y
# Consequence: plain malloc above 4 KB may return PSRAM. Any buffer that must be
# internal (DMA, ISR/cache-disabled access) must be allocated with
# heap_caps_malloc(..., MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA), never malloc.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# app_main loads the store (mxst_load keeps an mxs_data_t, ~1.9 KB, on the stack).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Colour / AprilTag detection run per frame on core 1: build with -O2.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Face detection (mxcam_face, human_face_detect): only the MSR+MNP s8 models
# (~190 KB), embedded in the app as flash rodata (with esp-dl the image is
# ~2.1 MB of the 4 MB factory partition). Weights are copied to PSRAM on load.
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y
